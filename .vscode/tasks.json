{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build PowerCode.PsMcp",
			"type": "shell",
			"command": "dotnet build PowerCode.PsMcp.slnx -c Debug -bl:artifacts/PowerCode.PsMcp.binlog",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Test PowerCode.PsMcp",
			"type": "shell",
			"command": "dotnet test --solution PowerCode.PsMcp.slnx -c Debug -bl:artifacts/PowerCode.PsMcp.Test.binlog",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": "$msCompile"
		}
	]
}