<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Underscore-separated Method_Scenario_Expected naming is standard for tests. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Test classes must be public for MSTest framework discovery. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- Pre-existing: StringComparison overloads and IDisposable patterns in test helpers. -->
    <NoWarn>$(NoWarn);CA1307;CA2000;CA2213</NoWarn>
    <MSTestAnalysisMode>All</MSTestAnalysisMode>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Microsoft.PowerShell.SDK brings the full PowerShell runtime for tests,
      including SMA and all built-in modules, so Get-Process etc. resolve.
    -->
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PowerCode.PsMcp\PowerCode.PsMcp.csproj" />
    <ProjectReference Include="..\..\src\PowerCode.PsMcp.Engine\PowerCode.PsMcp.Engine.csproj" />
  </ItemGroup>
</Project>
