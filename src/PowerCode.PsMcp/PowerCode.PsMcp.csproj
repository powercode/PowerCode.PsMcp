<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Force all NuGet lock-file assemblies to be copied to output on every
         platform. Without this, the .NET SDK marks many Microsoft.Extensions.*
         and System.* packages as framework-provided on Linux and omits them,
         leaving the Dependencies folder empty of third-party DLLs. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerCode.PsMcp.Engine\PowerCode.PsMcp.Engine.csproj" />
    <!--
      System.Management.Automation is a compile-time reference only.
      PowerShell provides its own copy at runtime, so we exclude runtime assets
      to avoid shipping duplicate assemblies in the module output folder.
    -->
    <PackageReference Include="System.Management.Automation" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copy the module manifest to the build output so PowerShell can load the module. -->
    <None Include="PowerCode.PsMcp.psd1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PowerCode.PsMcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="MoveDependenciesToSubfolder"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <!-- All DLLs in output that are NOT the module assembly itself. -->
      <DependencyDll Include="$(OutputPath)*.dll"
                     Exclude="$(OutputPath)PowerCode.PsMcp.dll" />
    </ItemGroup>

    <MakeDir Directories="$(OutputPath)Dependencies" />
    <Move SourceFiles="@(DependencyDll)"
          DestinationFolder="$(OutputPath)Dependencies"
          OverwriteReadOnlyFiles="true" />

    <!-- Also move corresponding PDB files for debuggability. -->
    <ItemGroup>
      <DependencyPdb Include="$(OutputPath)*.pdb"
                     Exclude="$(OutputPath)PowerCode.PsMcp.pdb" />
    </ItemGroup>

    <Move SourceFiles="@(DependencyPdb)"
          DestinationFolder="$(OutputPath)Dependencies"
          OverwriteReadOnlyFiles="true"
          Condition="'@(DependencyPdb)' != ''" />
  </Target>
</Project>